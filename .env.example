# -------------------------------------------------------------------
# Nirog — environment variables (CLIENT-SIDE only)
# -------------------------------------------------------------------
# These are bundled by Vite (prefix VITE_), so they ARE public.
# Treat anything placed here as known to anyone running the app.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -------------------------------------------------------------------
# SERVER-SIDE ONLY — used exclusively by scripts/seed.ts on a developer
# machine. NEVER import this variable into any src/ file, NEVER bundle
# it into the client build, NEVER commit a real value to git.
# scripts/seed.ts reads it directly via process.env.SUPABASE_SERVICE_ROLE_KEY
# (no VITE_ prefix → Vite will NOT inline it into the client bundle).
# -------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=server-side-only-do-not-commit

# -------------------------------------------------------------------
# Gemini API key — AI narration + alert copy ONLY.
# The clinical urgency band is set deterministically by the engine in
# src/lib/riskEngine/. Gemini never picks the band — it only writes
# human-readable copy from the already-decided numbers.
#
# Real key goes in Supabase Edge Function secrets (server-side only):
#   supabase secrets set GEMINI_API_KEY=your-real-key
# It is read inside supabase/functions/narrate-risk/index.ts and
# supabase/functions/narrate-alert/index.ts via Deno.env.
#
# DO NOT put a real key here — this is a placeholder so devs know the
# variable name. Leave the value empty in committed .env files.
# -------------------------------------------------------------------
GEMINI_API_KEY=
